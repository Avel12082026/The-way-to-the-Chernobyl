+app.post('/api/zone-route/step',requireAuth,rateLimit('zone-route-step',20,10000),(req,res)=>{
+    const playerId=String(req.telegramUser.id),raidToken=String(req.body?.raidToken||'');
+    try{
+        const out=db.transaction(()=>{
+            const sess=raidSession(playerId,raidToken);if(!sess)return{success:false,error:'Переход больше не активен'};
+            if(sess.pending_type)return{success:false,error:'Сначала завершите текущую встречу'};
+            const route=zoneRouteRow(playerId);
+            if(!route||route.raid_token!==raidToken)return{success:false,error:'Маршрут перехода не найден'};
+            if(Number(route.wins)>=Number(route.required_wins))return{success:true,event:{type:'none'},route:zoneRoutePublic(route,true)};
+            const row=db.prepare('SELECT data FROM players WHERE id=?').get(playerId);if(!row)return{success:false,error:'Игрок не найден'};
+            const data=safeParsePlayerData(row.data);
+            data.hunger=Math.max(0,Math.min(Number(data.maxHunger)||100,(Number(data.hunger)||0)-RaidSurvival.travelCost));
+            data.thirst=Math.max(0,Math.min(Number(data.maxThirst)||100,(Number(data.thirst)||0)-RaidSurvival.travelCost));
+            if(typeof serverRecomputeArtifactDerived==='function')serverRecomputeArtifactDerived(playerId,data);
+            const turnEffects=pveArtifactTurnEffects(data);
+            const radiationDamage=pveRadiationDamage(data);
+            let starvationDamage=0;if(data.hunger<=0)starvationDamage+=3;if(data.thirst<=0)starvationDamage+=3;
+            if(starvationDamage>0)data.health=Math.round(((Number(data.health)||0)-starvationDamage)*10)/10;
+            if(data.health<=0){
+                pveApplyDeathNow(data);
+                db.prepare('DELETE FROM raid_sessions WHERE player_id=?').run(playerId);
+                db.prepare('DELETE FROM pve_battles WHERE player_id=?').run(playerId);
+                db.prepare('UPDATE players SET data=?,last_seen=? WHERE id=?').run(JSON.stringify(data),Date.now(),playerId);
+                return{success:true,died:true,state:raidState(data),event:{type:'none'},route:null,turnEffects,radiationDamage,starvationDamage};
+            }
+            const tier=Number(route.enemy_tier)||1;
+            let event={type:'none'},pendingType=null,pendingPayload=null;
+            const roll=Math.random();
+            if(roll<0.35){
+                const npc=zoneRouteNpcPayload(playerId,data,tier,false);
+                const battleToken=crypto.randomBytes(24).toString('hex');
+                npc.zoneRoute={fromLocation:Number(route.from_location),toLocation:Number(route.to_location),enemyTier:tier};
+                npc.zoneLocation=Number(route.to_location);
+                db.prepare('DELETE FROM pve_battles WHERE player_id=?').run(playerId);
+                db.prepare('INSERT INTO pve_battles(player_id,token,enemy_kind,enemy_key,payload,started_at) VALUES(?,?,?,?,?,?)')
+                  .run(playerId,battleToken,'npc',`route:${route.from_location}>${route.to_location}:${npc.faction}:${npc.name}`,JSON.stringify(npc),Date.now());
+                pendingType='battle';pendingPayload=JSON.stringify({battleToken});
+                event={type:'battle',enemy:{...npc,battleToken,faction:{name:npc.faction}}};
+            }else if(roll<0.70){
+                const mutant=zoneRouteMutantPayload(tier);
+                if(mutant){
+                    const battleToken=crypto.randomBytes(24).toString('hex');
+                    mutant.zoneRoute={fromLocation:Number(route.from_location),toLocation:Number(route.to_location),enemyTier:tier};
+                    mutant.zoneLocation=Number(route.to_location);
+                    db.prepare('DELETE FROM pve_battles WHERE player_id=?').run(playerId);
+                    db.prepare('INSERT INTO pve_battles(player_id,token,enemy_kind,enemy_key,payload,started_at) VALUES(?,?,?,?,?,?)')
+                      .run(playerId,battleToken,'mutant',`route:${route.from_location}>${route.to_location}:${mutant.name}`,JSON.stringify(mutant),Date.now());
+                    pendingType='battle';pendingPayload=JSON.stringify({battleToken});
+                    event={type:'battle',enemy:{...mutant,battleToken}};
+                }
+            }else if(roll<0.82){
+                const pool=RAID_ANOMALIES.filter(a=>Number(a.tier)===tier&&!a.isNamedArtifactAnomaly);
+                if(pool.length){
+                    const a=pool[Math.floor(Math.random()*pool.length)];
+                    const payload={...a,attemptsUsed:0,resolved:false};
+                    pendingType='anomaly';pendingPayload=JSON.stringify(payload);event={type:'anomaly',anomaly:payload};
+                }
+            }else if(roll<0.92){
+                const npc=zoneRouteNpcPayload(playerId,data,tier,true);
+                npc.zoneLocation=Number(route.to_location);
+                pendingType='friendly';pendingPayload=JSON.stringify(npc);
+                event={type:'friendly',npc:{...npc,faction:{name:npc.faction}}};
+            }else{
+                const reward=zoneRouteLuckyReward(tier);
+                pendingType='lucky';pendingPayload=JSON.stringify(reward);event={type:'lucky',text:reward.text};
+            }
+            db.prepare('UPDATE raid_sessions SET pending_type=?,pending_payload=?,updated_at=? WHERE player_id=? AND token=?')
+              .run(pendingType,pendingPayload,Date.now(),playerId,raidToken);
+            db.prepare('UPDATE zone_routes SET updated_at=? WHERE player_id=?').run(Date.now(),playerId);
+            db.prepare('UPDATE players SET data=?,last_seen=? WHERE id=?').run(JSON.stringify(data),Date.now(),playerId);
+            return{success:true,died:false,state:raidState(data),event,route:zoneRoutePublic(route),turnEffects,radiationDamage,starvationDamage};
+        })();
+        return res.json(out);
+    }catch(e){console.error('[/api/zone-route/step]',e);return res.status(500).json({success:false,error:'Ошибка шага перехода'});}
+});
