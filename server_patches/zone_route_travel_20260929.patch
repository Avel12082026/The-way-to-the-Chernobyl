+app.post('/api/zone-route/start',requireAuth,rateLimit('zone-route-start',10,10000),(req,res)=>{
+    const playerId=String(req.telegramUser.id),raidToken=String(req.body?.raidToken||'');
+    const fromLocation=Number(req.body?.fromLocation||0),toLocation=Number(req.body?.toLocation||0);
+    if(!ZONE_ROUTE_EDGES.has(zoneRouteKey(fromLocation,toLocation)))
+        return res.status(400).json({success:false,error:'Такого перехода между локациями нет'});
+    try{
+        const out=db.transaction(()=>{
+            const sess=raidSession(playerId,raidToken);if(!sess)return{success:false,error:'Рейд не найден'};
+            if(sess.pending_type)return{success:false,error:'Сначала завершите текущую встречу'};
+            const row=db.prepare('SELECT data FROM players WHERE id=?').get(playerId);if(!row)return{success:false,error:'Игрок не найден'};
+            const data=safeParsePlayerData(row.data);
+            const current=Number(data?.worldPosition?.zoneLocation||fromLocation);
+            if(current!==fromLocation)return{success:false,error:'Игрок находится в другой локации'};
+            const old=zoneRouteRow(playerId);
+            if(old&&old.raid_token===raidToken&&Number(old.from_location)===fromLocation&&Number(old.to_location)===toLocation)
+                return{success:true,resumed:true,route:zoneRoutePublic(old)};
+            db.prepare('DELETE FROM zone_routes WHERE player_id=?').run(playerId);
+            const now=Date.now();
+            db.prepare(`INSERT INTO zone_routes(player_id,raid_token,from_location,to_location,enemy_tier,wins,required_wins,started_at,updated_at)
+                VALUES(?,?,?,?,?,0,?,?,?)`).run(playerId,raidToken,fromLocation,toLocation,toLocation,ZONE_ROUTE_REQUIRED_WINS,now,now);
+            return{success:true,resumed:false,route:zoneRoutePublic(zoneRouteRow(playerId))};
+        })();
+        return res.json(out);
+    }catch(e){console.error('[/api/zone-route/start]',e);return res.status(500).json({success:false,error:'Не удалось начать переход'});}
+});
+
+app.post('/api/zone-route/status',requireAuth,(req,res)=>{
+    const playerId=String(req.telegramUser.id);
+    return res.json({success:true,route:zoneRoutePublic(zoneRouteRow(playerId))});
+});
