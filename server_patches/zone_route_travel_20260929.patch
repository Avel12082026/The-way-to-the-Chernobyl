+// ZONE_ROUTE_API_V1
+const ZONE_ROUTE_REQUIRED_WINS=10;
+const ZONE_ROUTE_EDGES=new Set(['1>2','2>1','2>3','3>2','2>4','4>2','4>5','5>4','5>6','6>5']);
+function zoneRouteKey(fromLocation,toLocation){return Number(fromLocation)+'>'+Number(toLocation);}
+function zoneRouteRow(playerId){return db.prepare('SELECT * FROM zone_routes WHERE player_id=?').get(String(playerId));}
+function zoneRoutePublic(row,completed=false){
+    if(!row)return null;
+    return {
+        fromLocation:Number(row.from_location),toLocation:Number(row.to_location),
+        enemyTier:Number(row.enemy_tier),wins:Number(row.wins)||0,
+        requiredWins:Number(row.required_wins)||ZONE_ROUTE_REQUIRED_WINS,
+        completed:!!completed
+    };
+}
+function zoneRouteNpcPayload(playerId,data,tier,friendly){
+    tier=Math.max(1,Math.min(PVE_NPC_MAX_TIER,Number(tier)||1));
+    const factionPool=RAID_FACTIONS.filter(f=>friendly?!raidIsFactionHostile(playerId,data,f):raidIsFactionHostile(playerId,data,f));
+    const faction=factionPool[Math.floor(Math.random()*factionPool.length)]||(friendly?'Сталкеры':'Бандиты');
+    const safeWeapons=SHOP_WEAPONS.filter(w=>Number(w.tier)<=tier&&!w.adminOnly&&!w.isPremiumWeapon);
+    const safeArmors=SHOP_ARMOR.filter(a=>Number(a.tier)<=tier&&!a.adminOnly&&!a.isPremiumArmor&&!a.isResearchSuit);
+    const wt=Math.max(0,...safeWeapons.map(w=>Number(w.tier)||0));
+    const at=Math.max(0,...safeArmors.map(a=>Number(a.tier)||0));
+    const weaponPool=safeWeapons.filter(w=>Number(w.tier)===wt);
+    const armorPool=safeArmors.filter(a=>Number(a.tier)===at);
+    const weapon=weaponPool[Math.floor(Math.random()*weaponPool.length)]||SHOP_WEAPONS.find(w=>!w.adminOnly);
+    const armor=armorPool[Math.floor(Math.random()*armorPool.length)]||SHOP_ARMOR.find(a=>!a.adminOnly);
+    const hp=Math.max(1,Number(PVE_NPC_TIER_HP[tier])||tier*480);
+    return {
+        kind:'npc',name:raidNpcName(faction,tier),tier,faction,friendly:!!friendly,
+        weaponName:weapon&&weapon.name||'Кулаки',armorName:armor&&armor.name||'Без брони',
+        coins:Math.round(250*Math.pow(tier,1.55)),exp:Math.round(30+22*tier*tier),
+        hp,enemyHp:hp,maxEnemyHp:hp,
+        dmg:Math.max(1,Math.round((Number(PVE_NPC_TIER_DMG[tier])||tier*10)*(Number(PVE_NPC_TIER_MULT[tier])||1))),
+        hitChance:0.9,runChance:0.5,medkitsUsed:0
+    };
+}
+function zoneRouteMutantPayload(tier){
+    tier=Math.max(1,Number(tier)||1);
+    let pool=(Array.isArray(PVE_MUTANTS)?PVE_MUTANTS:[]).filter(m=>m&&!m.adminOnly&&Number(m.tier)===tier);
+    pool=pool.filter(m=>!['стронглав','самка стронглава'].includes(String(m.name||'').trim().toLowerCase()));
+    if(!pool.length)return null;
+    const total=pool.reduce((sum,m)=>sum+(Number(m.chance)||1),0);
+    let roll=Math.random()*total,pick=pool[pool.length-1];
+    for(const m of pool){const w=Number(m.chance)||1;if(roll<w){pick=m;break;}roll-=w;}
+    const hp=Math.max(1,Number(pick.hp)||1);
+    return {...pick,kind:'mutant',tier,sourceTier:Number(pick.tier)||tier,hp,enemyHp:hp,maxEnemyHp:hp,medkitsUsed:0};
+}
+function zoneRouteLuckyReward(tier){
+    tier=Math.max(1,Number(tier)||1);
+    const pool=[];
+    for(const name of ['Аптечка гражданская','Аптечка армейская','Аптечка научная','Антирад'])
+        pool.push({weight:24,reward:{name,nonStacking:false,text:`Мне повезло, я нашёл ${name.toLowerCase()}!`}});
+    const body=PVE_MUTANTS.filter(m=>m.loot&&Number(m.tier)<=tier);
+    if(body.length){const x=body[Math.floor(Math.random()*body.length)];pool.push({weight:8,reward:{name:x.loot,nonStacking:false,text:'Мне повезло, я нашёл часть тела мутанта!'}});}
+    const arm=SHOP_ARMOR.filter(a=>!a.adminOnly&&!a.isPremiumArmor&&!a.isResearchSuit&&Number(a.tier)<=tier);
+    if(arm.length){const x=arm[Math.floor(Math.random()*arm.length)];pool.push({weight:3,reward:{name:x.name,nonStacking:true,text:'Мне повезло, я нашёл броню!'}});}
+    const weap=SHOP_WEAPONS.filter(w=>!w.adminOnly&&!w.isPremiumWeapon&&Number(w.tier)<=tier);
+    if(weap.length){const x=weap[Math.floor(Math.random()*weap.length)];pool.push({weight:3,reward:{name:x.name,nonStacking:true,text:'Мне повезло, я нашёл оружие!'}});}
+    const art=SHOP_ARTIFACTS.filter(a=>!a.adminOnly&&!a.isNamedArtifact&&Number(a.tier)<=tier);
+    if(art.length){const x=art[Math.floor(Math.random()*art.length)];pool.push({weight:2,reward:{name:x.name,nonStacking:true,text:'Мне повезло, я нашёл артефакт!'}});}
+    const total=pool.reduce((sum,x)=>sum+x.weight,0);let roll=Math.random()*total,chosen=pool[0];
+    for(const x of pool){if(roll<x.weight){chosen=x;break;}roll-=x.weight;}
+    return chosen.reward;
+}
