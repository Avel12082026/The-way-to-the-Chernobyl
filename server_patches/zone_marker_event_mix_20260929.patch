+const ZONE_MAP_LUCKY_CHANCE=Object.freeze({1:0.10,2:0.08,3:0.065,4:0.05,5:0.035,6:0.025});
+function zoneMapMarkerEventKind(zoneKind,zoneLocation){
+    const lucky=Number(ZONE_MAP_LUCKY_CHANCE[zoneLocation])||0.025;
+    const weights=zoneKind==='anomaly'
+        ?[['anomaly',0.62],['mutant',0.12],['npc',0.10],['lucky',lucky]]
+        :zoneKind==='mutant'
+        ?[['mutant',0.58],['npc',0.13],['anomaly',0.10],['lucky',lucky]]
+        :[['npc',0.56],['mutant',0.14],['anomaly',0.10],['lucky',lucky]];
+    let roll=Math.random();
+    for(const [kind,weight] of weights){if(roll<weight)return kind;roll-=weight;}
+    return'none';
+}
