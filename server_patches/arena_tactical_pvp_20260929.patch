+app.post('/api/arena/battle/status',requireAuth,(req,res)=>{
+    const playerId=String(req.telegramUser.id),now=Date.now();
+    db.prepare('DELETE FROM arena_battles WHERE updated_at<?').run(now-ARENA_BATTLE_EXPIRE_MS);
+    const current=arenaLoadBattle(playerId);
+    return res.json({success:true,active:!!current,state:current?arenaPublicBattle(current.payload,current.row.token):null});
+});
+
+app.post('/api/arena/battle/start',requireAuth,rateLimit('arena-start',10,10000),(req,res)=>{
+    const attackerId=String(req.telegramUser.id),targetId=String(req.body?.targetId||'').trim(),now=Date.now();
+    if(!/^\d{1,30}$/.test(targetId))return res.status(400).json({success:false,error:'Некорректный ID противника'});
+    if(targetId===attackerId)return res.status(400).json({success:false,error:'Нельзя атаковать самого себя'});
+    db.prepare('DELETE FROM arena_battles WHERE updated_at<?').run(now-ARENA_BATTLE_EXPIRE_MS);
+    const existing=arenaLoadBattle(attackerId);
+    if(existing)return res.json({success:true,resumed:true,state:arenaPublicBattle(existing.payload,existing.row.token)});
+    if(db.prepare('SELECT 1 FROM pve_battles WHERE player_id=?').get(attackerId))
+        return res.status(409).json({success:false,error:'Сначала завершите текущий бой'});
+    const attackerRow=db.prepare('SELECT * FROM players WHERE id=?').get(attackerId);
+    const defenderRow=db.prepare('SELECT * FROM players WHERE id=?').get(targetId);
+    if(!attackerRow||!defenderRow)return res.status(404).json({success:false,error:'Игрок не найден'});
+    const attacker=safeParsePlayerData(attackerRow.data),defender=safeParsePlayerData(defenderRow.data);
+    if(attacker.lastArenaAttack&&now-Number(attacker.lastArenaAttack)<ARENA_COOLDOWN_MS){
+        const wait=Math.ceil((ARENA_COOLDOWN_MS-(now-Number(attacker.lastArenaAttack)))/1000);
+        return res.status(429).json({success:false,error:'Подождите ещё '+wait+' сек. перед следующим боем'});
+    }
+    if(attacker.lastArenaTarget===targetId&&attacker.lastArenaTargetAt&&now-Number(attacker.lastArenaTargetAt)<ARENA_SAME_TARGET_COOLDOWN_MS){
+        const wait=Math.ceil((ARENA_SAME_TARGET_COOLDOWN_MS-(now-Number(attacker.lastArenaTargetAt)))/1000);
+        return res.status(429).json({success:false,error:'Эту цель можно снова атаковать через '+wait+' сек.'});
+    }
+    const token=crypto.randomBytes(24).toString('hex');
+    const payload={round:1,finished:false,winner:null,a:arenaActorSnapshot(attackerId,attackerRow,attacker),b:arenaActorSnapshot(targetId,defenderRow,defender)};
+    attacker.lastArenaAttack=now;attacker.lastArenaTarget=targetId;attacker.lastArenaTargetAt=now;
+    const tx=db.transaction(()=>{
+        db.prepare('UPDATE players SET data=? WHERE id=?').run(JSON.stringify(attacker),attackerId);
+        db.prepare('INSERT INTO arena_battles(player_id,token,defender_id,payload,started_at,updated_at) VALUES(?,?,?,?,?,?)')
+          .run(attackerId,token,targetId,JSON.stringify(payload),now,now);
+    });tx();touchLastSeen(attackerId);
+    return res.json({success:true,resumed:false,state:arenaPublicBattle(payload,token)});
+});
+
+app.post('/api/arena/battle/action',requireAuth,rateLimit('arena-action',20,10000),(req,res)=>{
+    const playerId=String(req.telegramUser.id),token=String(req.body?.battleToken||''),action=String(req.body?.action||'');
+    if(!token)return res.status(400).json({success:false,error:'Бой на арене не найден'});
+    if(!ARENA_ACTIONS.has(action))return res.status(400).json({success:false,error:'Неизвестное действие'});
+    try{
+        const out=db.transaction(()=>{
+            const current=arenaLoadBattle(playerId,token);
+            if(!current)return{success:false,error:'Бой на арене уже завершён или истёк'};
+            const payload=current.payload;if(payload.finished)return{success:false,error:'Бой уже завершён'};
+            const resolved=arenaResolveRound(payload,action);if(resolved.error)return{success:false,error:resolved.error};
+            let outcome=null;
+            if(resolved.winner){
+                outcome=arenaFinalizeTactical(playerId,current.row.defender_id,resolved.winner);
+                db.prepare('DELETE FROM arena_battles WHERE player_id=? AND token=?').run(playerId,token);
+            }else{
+                db.prepare('UPDATE arena_battles SET payload=?,updated_at=? WHERE player_id=? AND token=?')
+                  .run(JSON.stringify(payload),Date.now(),playerId,token);
+            }
+            return{success:true,state:arenaPublicBattle(payload,token),events:resolved.events,
+                finished:!!resolved.winner,winner:resolved.winner||null,
+                ...(outcome||{ratingChange:0,premiumArmorDrop:null,draw:false})};
+        })();
+        return res.json(out);
+    }catch(e){
+        console.error('[/api/arena/battle/action]',e);
+        return res.status(500).json({success:false,error:'Не удалось обработать ход арены'});
+    }
+});
