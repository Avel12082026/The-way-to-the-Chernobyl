+const PVE_SAFE_CAMPS=Object.freeze({
+    'cordon-camp':{zoneLocation:1,place:'cordon-camp',origin:'cordon-camp'},
+    'rostok-bar':{zoneLocation:4,place:'rostok-bar',origin:'rostok-bar'},
+    'yantar-bunker':{zoneLocation:6,place:'yantar-bunker',origin:'yantar-bunker'}
+});
+function pveSafeCampAvailable(data,key){
+    if(key==='cordon-camp')return true;
+    if(key==='rostok-bar')return typeof zoneMapLocationUnlocked!=='function'||zoneMapLocationUnlocked(data,4);
+    if(key==='yantar-bunker')return typeof zoneMapLocationUnlocked!=='function'||zoneMapLocationUnlocked(data,6);
+    return false;
+}
+function pveRememberSafeCamp(data,key){
+    const camp=PVE_SAFE_CAMPS[key];
+    if(!camp||!pveSafeCampAvailable(data,key))return;
+    data.lastSafeCamp={...camp,updatedAt:Date.now()};
+}
+function pveResolveDeathSafeCamp(data){
+    const remembered=String(data?.lastSafeCamp?.origin||data?.lastSafeCamp?.place||'');
+    if(PVE_SAFE_CAMPS[remembered]&&pveSafeCampAvailable(data,remembered))return PVE_SAFE_CAMPS[remembered];
+    const origin=String(data?.worldPosition?.origin||'');
+    if(PVE_SAFE_CAMPS[origin]&&pveSafeCampAvailable(data,origin))return PVE_SAFE_CAMPS[origin];
+    const location=Number(data?.worldPosition?.zoneLocation)||1;
+    if(location>=6&&pveSafeCampAvailable(data,'yantar-bunker'))return PVE_SAFE_CAMPS['yantar-bunker'];
+    if(location>=4&&pveSafeCampAvailable(data,'rostok-bar'))return PVE_SAFE_CAMPS['rostok-bar'];
+    return PVE_SAFE_CAMPS['cordon-camp'];
+}
