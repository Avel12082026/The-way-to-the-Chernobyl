+function migrateZoneRouteUnlocksStrict20260929(){
+    const migrationName='zone_route_unlocks_strict_20260929';
+    if(migrationAlreadyRan(migrationName))return;
+    let changed=0;
+    const rows=db.prepare('SELECT id,data FROM players').all();
+    const update=db.prepare('UPDATE players SET data=? WHERE id=?');
+    const tx=db.transaction(()=>{
+        for(const row of rows){
+            const data=safeParsePlayerData(row.data);
+            const existing=new Set(Array.isArray(data.zoneUnlockedLocations)?data.zoneUnlockedLocations.map(Number).filter(Number.isInteger):[]);
+            let highest=Math.max(1,...existing);
+            const stored=Number(data?.worldPosition?.zoneLocation)||1;
+            if(stored>=2&&stored<=6)highest=Math.max(highest,stored);
+            const safe=Number(data?.lastSafeCamp?.zoneLocation)||1;
+            if(safe>=2&&safe<=6)highest=Math.max(highest,safe);
+            if(highest>1){
+                const before=JSON.stringify([...existing].sort((a,b)=>a-b));
+                for(let n=2;n<=highest;n++)existing.add(n);
+                data.zoneUnlockedLocations=[...existing].filter(n=>n>=2&&n<=11).sort((a,b)=>a-b);
+                if(JSON.stringify(data.zoneUnlockedLocations)!==before){update.run(JSON.stringify(data),row.id);changed++;}
+            }
+        }
+        markMigrationRan(migrationName);
+    });
+    tx();
+    if(changed)console.log('[migration] Зафиксированы достигнутые локации для '+changed+' игроков; уровень больше не открывает Зону');
+}
+migrateZoneRouteUnlocksStrict20260929();
